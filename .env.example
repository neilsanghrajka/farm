# Required for local Convex development. Deployment used by `pnpm exec convex dev`.
CONVEX_DEPLOYMENT=

# Required. Public Convex client URL used by Next.js.
NEXT_PUBLIC_CONVEX_URL=

# Required. Public Convex HTTP actions URL, generated by Convex when HTTP actions exist.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Required locally; hosted Convex provides this as a built-in. Convex Auth issuer URL used by convex/auth.config.ts.
CONVEX_SITE_URL=

# Required in Vercel/CI only. Never commit a real deploy key.
CONVEX_DEPLOY_KEY=

# Required. Public app URL used for redirects and OAuth return handling.
NEXT_PUBLIC_APP_URL=

# Required for X OAuth account-linking. Never commit real values.
X_CLIENT_ID=
# Optional; set only for confidential X OAuth clients.
X_CLIENT_SECRET=
# Required. Must exactly match the callback URL configured in the X app.
X_REDIRECT_URI=
# Optional; defaults in code to "tweet.read users.read like.write offline.access". X requires
# `tweet.read` and `users.read` for the user-context like flow and account id
# resolution. Farm uses them only for submitted post URLs.
X_OAUTH_SCOPES=
# Required private app metadata. Keep account-specific identifiers in env only.
X_APP_ID=
X_ENROLLED_ACCOUNT_ID=
X_TOKEN_ENCRYPTION_KEY=
# Optional server-side bearer tokens for public post metadata lookup.
X_BEARER_TOKEN=
X_API_BEARER_TOKEN=
