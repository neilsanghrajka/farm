# Deployment used by `pnpm exec convex dev`
CONVEX_DEPLOYMENT=

# Public Convex client URL used by Next.js
NEXT_PUBLIC_CONVEX_URL=

# Public Convex HTTP actions URL, generated by Convex when HTTP actions exist
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex Auth issuer URL used by convex/auth.config.ts
CONVEX_SITE_URL=

# Vercel/CI only. Never commit a real deploy key.
CONVEX_DEPLOY_KEY=

# Public app URL used for redirects and production callbacks
NEXT_PUBLIC_APP_URL=

# X OAuth account-linking integration. Never commit real secrets.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
# Defaults to "tweet.read users.read like.write offline.access". X requires
# `tweet.read` and `users.read` for the user-context like endpoint; Farm only
# uses them to resolve the numeric user id and like/unlike submitted post URLs.
X_OAUTH_SCOPES=
X_APP_ID=
X_ENROLLED_ACCOUNT_ID=
X_TOKEN_ENCRYPTION_KEY=
X_BEARER_TOKEN=
X_API_BEARER_TOKEN=
